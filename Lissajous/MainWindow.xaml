<Window x:Class="Lissajous.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lissajous"
        Title="Фігури Ліссажу" Height="600" Width="800">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Налаштування параметрів" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Амплітуда X (Ax > 0):"/>
            <TextBox Text="{Binding Ax, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Амплітуда Y (Ay > 0):"/>
            <TextBox Text="{Binding Ay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Частота X (Fx > 0) [Гц]:"/>
            <TextBox Text="{Binding Fx, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Частота Y (Fy > 0) [Гц]:"/>
            <TextBox Text="{Binding Fy, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding PhiX, StringFormat='Фаза X ({0}°):'}"/>
            <Slider Minimum="-180" Maximum="180" Value="{Binding PhiX, UpdateSourceTrigger=PropertyChanged}" 
                    TickFrequency="15" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding PhiY, StringFormat='Фаза Y ({0}°):'}"/>
            <Slider Minimum="-180" Maximum="180" Value="{Binding PhiY, UpdateSourceTrigger=PropertyChanged}" 
                    TickFrequency="15" IsSnapToTickEnabled="True" Margin="0,0,0,20"/>

            <Button Content="Побудувати" Command="{Binding PlotCommand}" Height="30"/>
        </StackPanel>

        <!-- Графік -->
        <Border Grid.Column="1" Margin="10" BorderBrush="Gray" BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <!-- Фіксований розмір полотна відповідає розміру у ViewModel -->
                <Canvas Width="500" Height="500" Background="White">
                    <!-- Осі координат -->
                    <Line X1="0" Y1="250" X2="500" Y2="250" Stroke="LightGray" StrokeThickness="1"/>
                    <Line X1="250" Y1="0" X2="250" Y2="500" Stroke="LightGray" StrokeThickness="1"/>

                    <!-- Сама фігура Ліссажу -->
                    <Polyline Points="{Binding PlotPoints}" Stroke="Blue" StrokeThickness="2" />
                </Canvas>
            </Viewbox>
        </Border>
    </Grid>
</Window>